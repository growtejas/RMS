{
  "root": true,
  "extends": ["next/core-web-vitals", "next/typescript"],
  "overrides": [
    {
      "files": ["src/app/**/*", "src/components/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/lib/queue/workers/*"],
                "message": "Phase 7 invariant: web request handlers must not import worker entry points. Import the producer module (e.g. `@/lib/queue/ai-evaluation-queue`) instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/queue/workers/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/components/**", "@/app/**"],
                "message": "Workers must not import client / route code. They are pure background processes."
              }
            ]
          }
        ]
      }
    }
  ]
}
